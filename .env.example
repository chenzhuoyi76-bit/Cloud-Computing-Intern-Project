OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

# Current local CI/CD backend only. Never commit real credentials.
# Optional: unset values use paths relative to the repository, not the shell.
